{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flax Engine SDK Artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "sdkVersion",
    "engine",
    "target",
    "os",
    "architecture",
    "minimumOSVersion",
    "libraries",
    "dynamicDependencies",
    "cmakeConfig",
    "cmakeTarget",
    "metadata",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "sdkVersion": {
      "type": "string"
    },
    "engine": {
      "enum": [
        "hermes",
        "v8"
      ]
    },
    "target": {
      "type": "string"
    },
    "os": {
      "enum": ["macos", "linux", "windows", "android", "ios"]
    },
    "architecture": {
      "enum": ["arm32", "arm64", "x64"]
    },
    "minimumOSVersion": {
      "type": "string"
    },
    "appleSdk": {
      "enum": ["iphoneos", "iphonesimulator"]
    },
    "minimumGlibcVersion": {
      "type": "string"
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "dynamicDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "importLibraries": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "cmakeConfig": {
      "const": "cmake/FlaxEngineSDKConfig.cmake"
    },
    "cmakeTarget": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
