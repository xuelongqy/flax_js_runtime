{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flax Engine SDK Artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "sdkVersion",
    "engine",
    "os",
    "architecture",
    "minimumOSVersion",
    "libraries",
    "cmakeConfig",
    "cmakeTarget",
    "metadata",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sdkVersion": {
      "type": "string"
    },
    "engine": {
      "enum": [
        "hermes",
        "v8"
      ]
    },
    "os": {
      "const": "macos"
    },
    "architecture": {
      "const": "arm64"
    },
    "minimumOSVersion": {
      "const": "15.0"
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cmakeConfig": {
      "const": "cmake/FlaxEngineSDKConfig.cmake"
    },
    "cmakeTarget": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
